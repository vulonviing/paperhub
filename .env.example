# Optional template for shell-based local development.
# Installed CLI users should prefer a signed-in `claude`/`codex` CLI (no key),
# or `paperhub set-key openai`.
# Ollama is local and does not need an API key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Provider options: claude-cli, codex-cli, openai, anthropic, google, ollama.
# Leave empty to auto-detect: an installed `claude`/`codex` CLI first (no API
# key needed), then a provider with a key, then openai.
# Defaults may be overridden by PaperHub(...).
PAPERHUB_PROVIDER=

# Optional global override. Leave empty to use the selected provider's default.
PAPERHUB_MODEL=

# Provider-specific defaults used when PaperHub(..., model=None).
PAPERHUB_OPENAI_MODEL=gpt-5.4-mini
PAPERHUB_OPENAI_REASONING_EFFORT=medium
PAPERHUB_ANTHROPIC_MODEL=claude-sonnet-4-6
PAPERHUB_GOOGLE_MODEL=gemini-3-flash-preview
PAPERHUB_CLAUDE_CLI_MODEL=
PAPERHUB_CLAUDE_CLI_EFFORT=medium
PAPERHUB_CODEX_CLI_MODEL=
PAPERHUB_CODEX_CLI_EFFORT=medium
PAPERHUB_OLLAMA_MODEL=gemma4:e2b
PAPERHUB_OLLAMA_BASE_URL=http://localhost:11434/v1

# Extra env var names to pass to claude/codex subprocesses (default: none).
PAPERHUB_CLI_PASS_ENV=

PAPERHUB_CONCURRENCY=5
PAPERHUB_MAX_PDF_CHARS=60000
PAPERHUB_CACHE_DIR=
PAPERHUB_REQUEST_TIMEOUT_S=30

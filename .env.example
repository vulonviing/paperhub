# Copy to .env for local live-provider runs. Do not commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Defaults may be overridden by PaperHub(...).
PAPERHUB_PROVIDER=anthropic

# Optional global override. Leave empty to use the selected provider's default.
PAPERHUB_MODEL=

# Provider-specific defaults used when PaperHub(..., model=None).
PAPERHUB_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
PAPERHUB_OPENAI_MODEL=gpt-4o-mini
PAPERHUB_GOOGLE_MODEL=gemini-2.5-pro

PAPERHUB_CONCURRENCY=5
PAPERHUB_MAX_PDF_CHARS=60000
PAPERHUB_CACHE_DIR=
PAPERHUB_REQUEST_TIMEOUT_S=30
